* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.cs text eol=lf
*.csproj text eol=lf
*.dart text eol=lf
*.patch text eol=lf -whitespace
*.ps1 text eol=crlf
*.iss text eol=crlf
*.zip -text
# Third-party originals keep their exact upstream bytes and whitespace.
LICENSE -text -whitespace
licenses/** -text -whitespace

# Preserve upstream FRP license bytes.
gateway/FRP-LICENSE.txt -text -whitespace
gateway/frp-diagnostics/FRP-LICENSE -text -whitespace
